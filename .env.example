# Neon Postgres connection string (pooled). Enable the vector extension on first db:migrate.
DATABASE_URL=

# Auth. Generate a long random string for production.
BETTER_AUTH_SECRET=
# Production BETTER_AUTH_URL is the public origin https://pamiac.com.
# /dash/config reports that baseURL and the dashboard compares it when the project URL changes.
BETTER_AUTH_URL=
# Better Auth Infrastructure project API key.
BETTER_AUTH_API_KEY=

# Optional Google sign-in. Both values must be set. Leave them empty to keep magic link only.
# Redirect URI locally: http://localhost:3000/api/auth/callback/google
# Redirect URI in production: https://pamiac.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=



# Magic-link email. Without RESEND_API_KEY, development shows the link on the login page.
# Set PAMIAC_DEV_MAGIC_LINK=1 to show that link locally. next dev alone does not.
# Cursor agents already set CURSOR_AGENT=1 and do not need this flag.
RESEND_API_KEY=
EMAIL_FROM=
PAMIAC_DEV_MAGIC_LINK=

# Exact text/plain body for GET /.well-known/openai-apps-challenge. Leave empty until OpenAI issues a domain challenge.
OPENAI_APPS_CHALLENGE=
