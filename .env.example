# Neon Postgres connection string (pooled). Enable the vector extension on first db:push.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Auth. Generate a long random string for production.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Magic-link email. Without RESEND_API_KEY, development shows the link on the login page.
RESEND_API_KEY=
EMAIL_FROM="Pamiac <login@your-domain.com>"
