# Neon Postgres connection string (pooled). Enable the vector extension on first db:migrate.
DATABASE_URL=

# Auth. Generate a long random string for production.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# BETTER_AUTH_API_KEY=



# Magic-link email. Without RESEND_API_KEY, development shows the link on the login page.
# Set PAMIAC_DEV_MAGIC_LINK=1 to show that link locally. next dev alone does not.
# Cursor agents already set CURSOR_AGENT=1 and do not need this flag.
RESEND_API_KEY=
EMAIL_FROM=
PAMIAC_DEV_MAGIC_LINK=

# Exact text/plain body for GET /.well-known/openai-apps-challenge. Leave empty until OpenAI issues a domain challenge.
OPENAI_APPS_CHALLENGE=
